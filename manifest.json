{
  "manifest_version": 3,
  "name": "Shorts Auto Next",
  "version": "2.2.0",
  "description": "YouTube Shorts에서 자동으로 다음 쇼츠로 넘기는 확장프로그램",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shorts Auto Next"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.youtube.com/shorts/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
